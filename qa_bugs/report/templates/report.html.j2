<!doctype html><html><head><meta charset="utf-8">
<title>Bug Analytics Report</title>
<script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
<style>body{font-family:system-ui;margin:24px}.grid{display:grid;gap:16px}.card{border:1px solid #eee;border-radius:12px;padding:16px;box-shadow:0 1px 3px rgba(0,0,0,.05)}.mono{font-family:ui-monospace,Menlo,Consolas,monospace;color:#777;font-size:12px;margin-top:6px}</style>
</head><body>
<h1>Bug Analytics Report</h1>
<p>Period: {{ meta.period.since if meta.period.since else 'ALL' }} .. {{ meta.period.until if meta.period.until else 'TIME' }} — Metrics: {{ meta.executed_metrics|join(', ') }}</p>
<h2>Key Metrics</h2>
{% if kpis and kpis|length > 0 %}
<div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
{% for k in kpis %}
  <div class="card">
    <div style="font-size:12px;color:#666;margin-bottom:6px;">{{ k.title }}</div>
    <div style="font-size:28px;font-weight:700;margin-bottom:8px;">{{ k.value }}</div>
    <ul style="margin:0;padding-left:18px;">{% for d in k.details %}<li style="font-size:13px;">{{ d }}</li>{% endfor %}</ul>
  </div>
{% endfor %}
</div>
{% else %}<div class="card"><em>No key metrics.</em></div>{% endif %}
<h2>Charts</h2>
<div class="grid">
{% for c in charts %}
  <div class="card">
    <div id="chart_{{ loop.index }}"></div>
    <script>
      const spec{{ loop.index }} = JSON.parse({{ c.spec | tojson }});
      Plotly.react('chart_{{ loop.index }}', spec{{ loop.index }}.data, spec{{ loop.index }}.layout, {responsive:true});
    </script>
    <div class="mono">metric: {{ c.metric }} · chart: {{ c.name }}</div>
  </div>
{% endfor %}
</div>
</body></html>
