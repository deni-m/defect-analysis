# Example secrets file for local development
# Copy this to secrets.toml and fill in your actual values
# DO NOT commit secrets.toml to git!

# Azure OpenAI - REQUIRED for LLM insights
# Endpoint, API version, and deployment are in configs/example.config.yml
AZURE_OPENAI_KEY = "your_azure_openai_api_key_here"

# Azure Storage - OPTIONAL (disabled by default)
# Only needed if you want to archive uploaded files
# To enable: Set azure_storage_enabled = True in app.py
# AZURE_STORAGE_CONNECTION_STRING = "DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net"
# AZURE_STORAGE_CONTAINER = "bug-analytics-uploads"
